                            e($record->name).
                            '" class="h-8 w-8 rounded-full object-cover">
                                <div class="leading-tight">
                                    <span class="font-bold">'.
                            $name.
                            '</span>'.
                            $roles.
                            '</div>
                            </div>
                        ';
