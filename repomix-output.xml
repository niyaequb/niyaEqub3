    protected function handleRecordCreation(array $data): Member
    {
        $userData = $data['user'] ?? [];
        $memberData = Arr::except($data, ['user']);

        $user = User::create([
            'name' => $memberData['full_name'],
            'phone' => $userData['phone'],
