                    ->label(__('filament.actions.view')),
                    EditAction::make()
                    ->visible(fn (): bool =>
                        Auth::check() &&
                         ( Auth::user()->hasRole('Super Admin') || Auth::user()->can('users.edit')))
                    ->label(__('filament.actions.edit')),
                    Action::make('activate')
                        ->label('Activate')
                        ->color('success')
                        ->icon('heroicon-s-check-circle')
                        ->visible(function (User $record): bool {
