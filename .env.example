APP_NAME="Niya Ekub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=niya_ekub
DB_USERNAME=root
DB_PASSWORD=
# Full DSN. When set it overrides the individual DB_* values above
# (used by hosts such as Zergaw and Heroku).
# DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage. Set FILESYSTEM_DISK=r2 in production and point
# the endpoint at Cloudflare R2 in config/filesystems.php.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------
# API authentication
#--------------------------------------------------------------------
# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60

#--------------------------------------------------------------------
# SMS and OTP
# SMS_MODE=1 -> AfroMessage (OTPs managed by the provider)
# SMS_MODE=2 -> GeezSMS (OTPs generated locally, stored in `otps`)
#--------------------------------------------------------------------
SMS_MODE=1

AFRO_BASE_URL=https://api.afromessage.com/api
AFRO_API_KEY=
AFRO_IDENTIFIER_ID=
AFRO_SENDER_NAME=
AFRO_OPT_LENGTH=4
AFRO_CALLBACK_URL=
OTP_TTL_MINUTES=5

GEEZ_SMS_BASE_URL=
GEEZ_SMS_TOKEN=
GEEZ_SMS_SHORTCODE_ID=

#--------------------------------------------------------------------
# Payments — banks
#--------------------------------------------------------------------
# WHERE THESE ACTUALLY LIVE IN PRODUCTION
#
# Everything from here down can also be set from Admin -> Settings, and
# when it is, THAT is the value the application uses. Saving on that screen
# writes to the `global_settings` table, not to this file, because the app
# is deployed on a host that rebuilds its container from the build image on
# every deploy: a value written to a file there lasts until the next
# restart and no longer.
#
# The variables below are still read, and are still the right place for a
# machine-level secret. They are the FALLBACK — used when nothing has been
# saved in the admin panel. That is how a fresh deployment boots before
# anyone has opened Settings, and how an operator who would rather keep
# credentials in the platform dashboard than the database can do so.
#
# Resolution order, every time:
#   saved setting  ->  environment variable  ->  built-in default
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Niya collects through several banks. Every gateway reads its own keys
# through a prefix declared in config/payments.php, so adding CBE means
# copying this block with CBE_ in place of DASHEN_ — nothing collides and
# nothing is shared.
#
# A bank whose credentials are incomplete is withheld from the apps
# rather than offered and then failing when someone tries to pay.
#
#--- Dashen Bank -----------------------------------------------------
# Issued by Dashen on the Mini App Credentials sheet at onboarding.
# All of these are signing material: change one and every order signed
# with the old value stops being accepted.
# LEFT BLANK ON PURPOSE. This file is committed to git; real credentials
# belong in .env, which is not. Copy this block there and fill it in.
DASHEN_MERCHANT_CODE=
DASHEN_MERCHANT_APP_ID=
DASHEN_FABRIC_APP_ID=
DASHEN_MINI_APP_CODE=
DASHEN_SHORT_CODE=
DASHEN_APP_SECRET=

# The RSA public key. TWO WAYS, AND THEY SUIT DIFFERENT MACHINES.
#
# LOCAL / ANY SERVER WITH A PERSISTENT DISK — use the file. Save the key
# exactly as the bank sent it to:
#
#   storage/app/payments/dashen-public.pem
#
# A PEM block is eleven lines and a .env value is one, so it cannot be
# pasted into this file directly: dotenv reads line by line and would take
# the first line and parse the rest as malformed entries.
#
# HOSTED DEPLOYMENT (App Platform and the like) — use the admin panel. The
# file will NOT be there: storage/app/payments is gitignored, correctly,
# since signing material does not belong in a repository, and so it is in
# no build image either. Paste the PEM into the RSA Public Key box under
# Admin -> Settings -> Payment instead. That is stored in the database, has
# no line-length problem to work around, and survives a redeploy.
#
# The file wins when it is readable. When a path is set but the file is
# missing, the stored key is used and a warning is logged.
DASHEN_PUBLIC_KEY_PATH=storage/app/payments/dashen-public.pem
DASHEN_PUBLIC_KEY=

# uat or production. Signed into every request, so it must match the stage
# the mini app is running against.
DASHEN_STAGE=uat

# How long the SuperApp holds the order open before abandoning it.
DASHEN_TIMEOUT_EXPRESS=120m

# Which fields go inside the RSA-encrypted `sign`, in dot notation.
#
# How much fits depends on the key size. A 2048-bit key allows ~214 bytes
# under OAEP, which is smaller than biz_content alone and forces a minimal
# subset. A 4096-bit key allows ~470, and a full request is around 420 — so
# the whole object fits, which matches encryptPayload({...req}) in the
# vendor sample.
#
# Confirm the list with the bank either way. Asking for too much throws a
# clear error rather than silently producing ciphertext they cannot decrypt.
DASHEN_SIGN_KEYS=timestamp,nonce_str,method,version,biz_content

# oaep (Node's crypto.publicEncrypt default, which the sample uses) or pkcs1.
DASHEN_RSA_PADDING=oaep

# OPTIONAL — only for banks that expose a server-to-server API.
#
# Several of these super-app integrations do not: the bank's app talks to the
# bank's core system and this server never sends REST requests at all. Dashen
# is one of them, which is why they are empty.
#
# Empty is supported and safe. What it costs is AUTOMATIC settlement: with no
# endpoint to ask "did this charge complete", contributions stay PENDING until
# an operator confirms them against the bank's merchant portal under
# Admin -> Equb Payments. Sign-in through the bank app is likewise inactive
# and members use phone-and-OTP as usual.
#
# Settlement is deliberately NOT taken from the app's own payment callback:
# it comes from the member's device and carries no proof, so trusting it
# would let anyone mark their own contributions paid.
DASHEN_BASE_URL=
DASHEN_TOKEN_PATH=
DASHEN_ORDER_QUERY_PATH=

#--------------------------------------------------------------------
# Push notifications — Firebase Cloud Messaging
#
# Upload the service account JSON at Admin -> Settings -> Firebase. It is
# kept in `global_settings` under `env:FIREBASE_SERVICE_ACCOUNT_JSON`, and
# the file at the path below is a cache of it that is written back
# automatically whenever the container does not have it. Uploading is
# therefore a one-time job rather than something to redo after every
# deploy, which is what it used to be.
#--------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=storage/app/firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_USE_HTTP_V1=true

#--------------------------------------------------------------------
# Equb engine
#--------------------------------------------------------------------
# Seconds to pause before revealing a winner, for the app animation.
EQUB_DRAW_DELAY=30
EQUB_AUTO_DRAW_ENABLED=false
EQUB_AUTO_START_ENABLED=true
# Members covered by one draw; sets how many draws a day a group may run.
EQUB_MEMBERS_PER_DRAW=50
EQUB_RESTRICT_DRAW_FREQUENCY=true
# Refuse draws on days that are not a scheduled draw date.
EQUB_ENFORCE_DRAW_SCHEDULE=false

#--------------------------------------------------------------------
# Group Equb (member-created groups)
#--------------------------------------------------------------------
# Require an admin to approve a group before its creator can start it.
# Off by default: groups go live immediately and admins review by exception.
EQUB_GROUP_REQUIRES_APPROVAL=false
EQUB_GROUP_MIN_MEMBERS=2
EQUB_GROUP_MAX_MEMBERS=100
EQUB_INVITATION_TTL_DAYS=14
