APP_NAME="Niya Ekub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=niya_ekub
DB_USERNAME=root
DB_PASSWORD=
# Full DSN. When set it overrides the individual DB_* values above
# (used by hosts such as Zergaw and Heroku).
# DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage. Set FILESYSTEM_DISK=r2 in production and point
# the endpoint at Cloudflare R2 in config/filesystems.php.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------
# API authentication
#--------------------------------------------------------------------
# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60

#--------------------------------------------------------------------
# SMS and OTP
# SMS_MODE=1 -> AfroMessage (OTPs managed by the provider)
# SMS_MODE=2 -> GeezSMS (OTPs generated locally, stored in `otps`)
#--------------------------------------------------------------------
SMS_MODE=1

AFRO_BASE_URL=https://api.afromessage.com/api
AFRO_API_KEY=
AFRO_IDENTIFIER_ID=
AFRO_SENDER_NAME=
AFRO_OPT_LENGTH=4
AFRO_CALLBACK_URL=
OTP_TTL_MINUTES=5

GEEZ_SMS_BASE_URL=
GEEZ_SMS_TOKEN=
GEEZ_SMS_SHORTCODE_ID=

#--------------------------------------------------------------------
# Payments — banks
#--------------------------------------------------------------------
# Niya collects through several banks. Every gateway reads its own keys
# through a prefix declared in config/payments.php, so adding CBE means
# copying this block with CBE_ in place of DASHEN_ — nothing collides and
# nothing is shared.
#
# A bank whose credentials are incomplete is withheld from the apps
# rather than offered and then failing when someone tries to pay.
#
#--- Dashen Bank -----------------------------------------------------
# Issued by Dashen on the Mini App Credentials sheet at onboarding.
# All of these are signing material: change one and every order signed
# with the old value stops being accepted.
# LEFT BLANK ON PURPOSE. This file is committed to git; real credentials
# belong in .env, which is not. Copy this block there and fill it in.
DASHEN_MERCHANT_CODE=
DASHEN_MERCHANT_APP_ID=
DASHEN_FABRIC_APP_ID=
DASHEN_MINI_APP_CODE=
DASHEN_SHORT_CODE=
DASHEN_APP_SECRET=

# The RSA public key. PUT IT IN A FILE, NOT HERE.
#
# A PEM block is eleven lines and a .env value is one: dotenv reads line by
# line, so pasting a real key inline captures the first line and parses the
# rest as malformed entries — a boot error at best, a silently truncated key
# at worst. Save the key exactly as the bank sent it and point at it:
#
#   storage/app/payments/dashen-public.pem
#
# The inline form below still works for a single line with literal
# backslash-n escapes, which is what the admin Settings screen writes. Set
# one or the other; the path wins.
DASHEN_PUBLIC_KEY_PATH=storage/app/payments/dashen-public.pem
DASHEN_PUBLIC_KEY=

# uat or production. Signed into every request, so it must match the stage
# the mini app is running against.
DASHEN_STAGE=uat

# How long the SuperApp holds the order open before abandoning it.
DASHEN_TIMEOUT_EXPRESS=120m

# Which fields go inside the RSA-encrypted `sign`, in dot notation.
#
# RSA encrypts at most ~214 bytes in one operation, which is smaller than
# the full request, so signing a subset is forced by the maths rather than
# chosen for convenience. Dashen's sample calls this `keysToPick` and never
# says what is in it — confirm the list with them and set it here. Asking
# for too much throws a clear error rather than silently producing
# ciphertext Dashen cannot decrypt.
DASHEN_SIGN_KEYS=biz_content.merch_order_id,biz_content.total_amount,biz_content.merch_code,timestamp,nonce_str

# oaep (Node's crypto.publicEncrypt default, which the sample uses) or pkcs1.
DASHEN_RSA_PADDING=oaep

# NOT SUPPLIED BY DASHEN YET.
#
# While these are empty, settlement verification fails closed: notifications
# are logged and contributions stay pending rather than being credited on a
# claim nobody can confirm. Login with DBSA is likewise inactive and the app
# falls back to phone-and-OTP sign-in. Fill them in and both go live with no
# code change.
DASHEN_BASE_URL=
DASHEN_TOKEN_PATH=
DASHEN_ORDER_QUERY_PATH=

#--------------------------------------------------------------------
# Push notifications — Firebase Cloud Messaging
# In production the service account JSON is stored in the
# `global_settings` table under the key `firebase_credentials_json`.
#--------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=storage/app/firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_USE_HTTP_V1=true

#--------------------------------------------------------------------
# Equb engine
#--------------------------------------------------------------------
# Seconds to pause before revealing a winner, for the app animation.
EQUB_DRAW_DELAY=30
EQUB_AUTO_DRAW_ENABLED=false
EQUB_AUTO_START_ENABLED=true
# Members covered by one draw; sets how many draws a day a group may run.
EQUB_MEMBERS_PER_DRAW=50
EQUB_RESTRICT_DRAW_FREQUENCY=true
# Refuse draws on days that are not a scheduled draw date.
EQUB_ENFORCE_DRAW_SCHEDULE=false

#--------------------------------------------------------------------
# Group Equb (member-created groups)
#--------------------------------------------------------------------
# Require an admin to approve a group before its creator can start it.
# Off by default: groups go live immediately and admins review by exception.
EQUB_GROUP_REQUIRES_APPROVAL=false
EQUB_GROUP_MIN_MEMBERS=2
EQUB_GROUP_MAX_MEMBERS=100
EQUB_INVITATION_TTL_DAYS=14
